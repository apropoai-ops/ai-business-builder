# ─────────────────────────────────────────────────────────────
#  AI Business Builder — Environment Variables
#  Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Providers ──────────────────────────────────────────────
# At least one is required. Both recommended (Claude=reasoning, OpenAI=embeddings).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Image generation providers, tried in order: Gemini (free tier — Google
# currently grants 0 image quota to NEW accounts, but the key is kept first so
# it takes over if quota appears; key from https://aistudio.google.com/apikey)
# → Pollinations (always free, NO KEY NEEDED — works out of the box)
# → OpenAI gpt-image (paid, last on purpose).
GEMINI_API_KEY=

# Default models (override per-agent as needed)
AI_REASONING_MODEL=claude-opus-4-8
AI_FAST_MODEL=claude-haiku-4-5
AI_EMBEDDING_MODEL=text-embedding-3-small
# FREE text mode: when GEMINI_API_KEY is set, ALL text agents run on Gemini's
# free API tier ($0) with Claude as automatic fallback. Force paid Claude back
# with AI_PROVIDER=anthropic. Override the Gemini model via AI_GEMINI_MODEL.
AI_PROVIDER=
AI_GEMINI_MODEL=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── WhatsApp Business Cloud API (Meta) ────────────────────────
# Verify token: any random string; paste the same value into Meta's webhook
# config. App secret: Meta App → Settings → Basic (validates webhook signatures).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# ── Vercel Cron (daily AI CEO brief) ──────────────────────────
# Random string; Vercel sends it as a Bearer token to /api/cron/* routes.
CRON_SECRET=

# ── Email notifications (Resend) ──────────────────────────────
# Free tier: 3,000 emails/month, one API key. Dormant until set — owner
# notifications (new order / accepted quote) simply don't send without it.
# Get a free key at resend.com → API Keys. RESEND_FROM is optional:
# defaults to onboarding@resend.dev (works with zero domain setup); set it to
# a verified-domain sender for production deliverability.
RESEND_API_KEY=
RESEND_FROM=

# ── Stripe (billing — M7) ─────────────────────────────────────
# Billing stays dormant until all four are set (UI shows "coming soon").
# Webhook endpoint: /api/webhooks/stripe
# Create 3 recurring monthly prices in Stripe and paste their price ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ── Bot protection (Cloudflare Turnstile) ─────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Store payments (per-business card clearing) ───────────────
# 32-byte key that encrypts each business's payment-provider credentials.
PAYMENTS_ENC_KEY=
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=

# ── Web push notifications ────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Optional ──────────────────────────────────────────────────
# Stock photos for generated sites.
PEXELS_API_KEY=
# Comma-separated OAuth providers shown on login, e.g. "google".
NEXT_PUBLIC_AUTH_PROVIDERS=
# Comma-separated user ids exempt from the business quota (operators).
UNLIMITED_BUSINESS_USER_IDS=
